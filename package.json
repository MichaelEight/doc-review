{
  "name": "doc-review",
  "version": "0.2.0",
  "description": "Comment on documents Google-Docs-style and let AI handle your comments. Standalone app with your own AI key, or an MCP server for Claude Code, Cursor and others.",
  "type": "module",
  "bin": {
    "doc-review": "bin/doc-review.js"
  },
  "files": [
    "bin",
    "src",
    "web",
    ".claude/skills",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/doc-review.js",
    "serve": "node src/server.js --serve",
    "test": "node --test",
    "app": "electron .",
    "dist": "electron-builder --config app/electron-builder.yml --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "review",
    "markdown",
    "latex",
    "comments",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelEight/doc-review.git"
  },
  "license": "MIT",
  "main": "app/main.cjs",
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  }
}
